# Kimai MCP Streamable HTTP Server Configuration
# Copy this file to .env and fill in your values
#
# This configures the kimai-mcp-streamable server (Claude.ai Connectors),
# the only remote server since v2.16.0 removed the SSE server.

# =============================================================================
# REQUIRED: Users configuration
# =============================================================================

# Path to users.json (per-user Kimai credentials + OAuth auth_secret)
# See config/users.example.json for the format
# USERS_CONFIG_FILE=/app/config/users.json

# Alternative to users.json: configure users via environment variables
# KIMAI_USER_<SLUG>_URL=https://kimai.example.com
# KIMAI_USER_<SLUG>_TOKEN=kimai-api-token
# KIMAI_USER_<SLUG>_AUTH_SECRET=long-random-oauth-login-secret

# =============================================================================
# OAuth 2.1 (recommended way to connect Claude.ai)
# =============================================================================

# Public base URL of this server = OAuth issuer.
# REQUIRED behind a reverse proxy; must be HTTPS (except localhost).
# KIMAI_MCP_PUBLIC_URL=https://mcp.example.com

# Persist registered OAuth clients across restarts (optional)
# KIMAI_MCP_OAUTH_STATE_FILE=/app/config/oauth_clients.json

# Disable the deprecated /mcp/{slug} endpoints (recommended once OAuth works)
# KIMAI_MCP_DISABLE_LEGACY_SLUGS=true

# =============================================================================
# OIDC federated login (optional)
# =============================================================================

# KIMAI_MCP_AUTH_BACKEND=oidc
# KIMAI_MCP_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# KIMAI_MCP_OIDC_CLIENT_ID=<client-id>
# KIMAI_MCP_OIDC_CLIENT_SECRET=<client-secret>

# =============================================================================
# Automatic onboarding (optional; requires the OIDC backend)
# =============================================================================

# Resolve an unknown OIDC identity against Kimai and create that user's own API
# token at first sign-in instead of rejecting it. Needs the ApiTokenBundle
# plugin on the Kimai server - see kimai-plugin/ApiTokenBundle/README.md.
# KIMAI_MCP_AUTO_PROVISION=true
# KIMAI_MCP_PROVISION_KIMAI_URL=https://kimai.example.com

# Kimai token of a user with 'api-token_other_profile' (to mint tokens) and
# 'view_user' (to list users at all); ROLE_SUPER_ADMIN has both by default.
# Keep it out of the command line and out of version control.
# KIMAI_MCP_PROVISION_ADMIN_TOKEN=kimai-super-admin-api-token

# Mail domains allowed to be onboarded, comma-separated. Strongly recommended:
# without it, any identity your issuer asserts whose address local part equals a
# Kimai username is provisioned as that user - which matters as soon as the
# issuer is not single-tenant (Entra common/organizations, B2B guests, Google
# without an hd claim, social connections).
# KIMAI_MCP_PROVISION_ALLOWED_DOMAINS=corp.example,corp.de

# exact | normalized (default) | fuzzy - read the README before using fuzzy
# KIMAI_MCP_PROVISION_MATCH=normalized

# Name of the created tokens, as shown in the user's Kimai profile
# KIMAI_MCP_PROVISION_TOKEN_NAME=Kimai MCP (auto)

# Keep provisioned users across restarts. Holds Kimai tokens in plaintext and is
# written with mode 0600; omit to keep them in memory only.
# KIMAI_MCP_PROVISION_STORE=/app/config/provisioned_users.json

# SSL verification for the provisioning calls: true, false or a CA bundle path
# KIMAI_MCP_PROVISION_SSL_VERIFY=true

# =============================================================================
# Security
# =============================================================================

# Only trust X-Forwarded-For / X-Real-IP from these peers (comma-separated).
# Set this to your reverse proxy IP(s); otherwise the direct peer IP is used.
# KIMAI_MCP_TRUSTED_PROXIES=127.0.0.1

# Requests per minute per IP (default: 60, 0 to disable)
# RATE_LIMIT_RPM=60

# =============================================================================
# SSL/TLS for Kimai connections
# =============================================================================

# Options: true (default), false, or path to CA certificate file
# KIMAI_SSL_VERIFY=true
# KIMAI_SSL_VERIFY=/app/certs/ca-bundle.crt

# =============================================================================
# Server binding
# =============================================================================

# Port to expose the server on (default: 8000)
# SERVER_PORT=8000
